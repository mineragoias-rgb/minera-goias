[Unit]
Description=Import GitHub data files into Minera Goias source database
After=network.target mysql.service

[Service]
Type=oneshot
User=minera-ingest
Group=minera-ingest
EnvironmentFile=/etc/minera-goias-ingestion.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/local/lib/minera-goias-ingestion/run-vps.sh
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minera-goias-ingestion
MemoryMax=1G
CPUQuota=50%
Nice=10
UMask=0077
