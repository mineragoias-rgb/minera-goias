 "periodo": {
  "comment": "Padrões de período lidos no próprio texto. Sem período explícito o candidato fica 'periodo_indefinido' e NÃO é confrontado com a base: o agente não deduz o ano pela data da matéria. Os padroes sao avaliados do mais especifico para o mais geral: trimestre, depois semestre, depois ano — senao 'no primeiro semestre de 2025' seria lido como o ano de 2025.",
  "padroes": [
   {
    "id": "trimestre_pt",
    "regex": "\\b(?P<n>primeiro|segundo|terceiro|quarto)\\s+trimestre\\s+de\\s+(?P<ano>20\\d{2})\\b",
    "tipo": "trimestre",
    "formato": "{ano}-Q{n}"
   },
   {
    "id": "trimestre_num_pt",
    "regex": "\\b(?P<n>[1-4])t(?P<ano2>\\d{2})\\b",
    "tipo": "trimestre",
    "formato": "20{ano2}-Q{n}"
   },
   {
    "id": "trimestre_en",
    "regex": "\\bq(?P<n>[1-4])\\s+(?P<ano>20\\d{2})\\b",
    "tipo": "trimestre",
    "formato": "{ano}-Q{n}"
   },
   {
    "id": "semestre_pt",
    "regex": "\\b(?P<n>primeiro|segundo)\\s+semestre\\s+de\\s+(?P<ano>20\\d{2})\\b",
    "tipo": "semestre",
    "formato": "{ano}-S{n}"
   },
   {
    "id": "semestre_num_pt",
    "regex": "\\b(?P<n>[12])s(?P<ano2>\\d{2})\\b",
    "tipo": "semestre",
    "formato": "20{ano2}-S{n}"
   },
   {
    "id": "semestre_en",
    "regex": "\\bh(?P<n>[12])\\s+(?P<ano>20\\d{2})\\b",
    "tipo": "semestre",
    "formato": "{ano}-S{n}"
   },
   {
    "id": "ano_pt",
    "regex": "\\b(?:em|de|do ano de|no ano de|ano-base)\\s+(?P<ano>20\\d{2})\\b",
    "tipo": "ano",
    "formato": "{ano}"
   },
   {
    "id": "ano_en",
    "regex": "\\b(?:full[- ]year|fy|in|for)\\s+(?P<ano>20\\d{2})\\b",
    "tipo": "ano",
    "formato": "{ano}"
   }
  ]
 },
 "padroes": [
  {
   "id": "P01",
   "idioma": "pt",
   "ativo": true,
   "origem": "manual",
   "descricao": "verbo de producao, numero, unidade, 'de', mineral — 'produziu 5.231 toneladas de niobio'",
   "regex": "(?:produziu|produziram|produzidas|produzidos|producao de|extraiu|beneficiou)\\s+(?:cerca de\\s+|aproximadamente\\s+)?{NUM}\\s*{ESC}?\\s*(?:de\\s+)?{UNI}\\s+de\\s+{MIN}"
  },
  {
   "id": "P02",
   "idioma": "pt",
   "ativo": true,
   "origem": "manual",
   "descricao": "mineral, palavra de producao, numero, unidade — 'a producao de niobio alcancou 10.348 t'",
   "regex": "{MIN}[^.;]{0,60}?(?:producao|produziu|atingiu|alcancou|somou|totalizou|chegou a)[^.;]{0,25}?{NUM}\\s*{ESC}?\\s*(?:de\\s+)?{UNI}"
  },
  {
   "id": "P03",
   "idioma": "en",
   "ativo": true,
   "origem": "manual",
   "descricao": "verbo de producao, numero, unidade, 'of', mineral — 'produced 43,974 tonnes of copper'",
   "regex": "(?:produced|production of|output of|delivered)\\s+(?:about\\s+|approximately\\s+|over\\s+)?{NUM}\\s*{ESC}?\\s*{UNI}\\s+of\\s+{MIN}"
  },
  {
   "id": "P04",
   "idioma": "en",
   "ativo": true,
   "origem": "manual",
   "descricao": "mineral, 'production', verbo de ligacao, numero, unidade — 'copper production was 43,974 tonnes'",
   "regex": "{MIN}\\s+production[^.;]{0,40}?(?:was|of|totalled|totaled|reached|came in at|stood at)\\s+(?:about\\s+|approximately\\s+)?{NUM}\\s*{ESC}?\\s*{UNI}"
  },
  {
   "id": "P05",
   "idioma": "pt",
   "ativo": true,
   "origem": "manual",
   "descricao": "embarque ou exportacao — 'embarcou 678 toneladas de terras raras'",
   "regex": "(?:embarcou|embarcadas|embarcados|exportou|exportacao de|exportadas)\\s+(?:cerca de\\s+)?{NUM}\\s*{ESC}?\\s*(?:de\\s+)?{UNI}\\s+de\\s+{MIN}"
  },
  {
   "id": "P06",
   "idioma": "pt",
   "ativo": true,
   "origem": "manual",
   "descricao": "capacidade declarada — 'capacidade de 80.000 toneladas de vermiculita por ano'",
   "regex": "capacidade[^.;]{0,30}?{NUM}\\s*{ESC}?\\s*(?:de\\s+)?{UNI}\\s+de\\s+{MIN}"
  },
  {
   "id": "P07",
   "idioma": "en",
   "ativo": true,
   "origem": "manual",
   "descricao": "mineral, numero, unidade, palavra de producao — 'gold: 7,067 ounces produced'",
   "regex": "{MIN}[^.;]{0,40}?{NUM}\\s*{ESC}?\\s*{UNI}\\s+(?:produced|of production|were produced)"
  }
 ],
